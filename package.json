{
  "name": "dlmm-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone wallet-triggered Meteora DLMM bot for Solana",
  "main": "index.js",
  "bin": {
    "meridian": "cli.js"
  },
  "scripts": {
    "setup": "node setup.js",
    "env:encrypt": "node scripts/envrypt.js encrypt",
    "start": "node index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart meridian --update-env",
    "pm2:logs": "pm2 logs meridian --lines 100",
    "dev": "DRY_RUN=true node index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:syntax && vitest run",
    "test:syntax": "node scripts/check-syntax.js",
    "postinstall": "node scripts/patch-anchor.js",
    "test:standalone": "vitest run test/standalone.test.ts",
    "test:acceptance": "vitest run test/acceptance.test.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "1.9.4",
    "@solana/web3.js": "^1.95.0",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "dotenv": "^17.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^4.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
